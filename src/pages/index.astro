---
import PageLayoutTA from '@/components/PageLayoutTA.astro';
import ActionHeaderTA from '@/components/ActionHeaderTA.astro';
import HeroCareTA from '@/components/HeroCareTA.astro';
import IconTA from '@/components/IconTA.astro';
import ServicePhotosPreviewTA from '@/components/ServicePhotosPreviewTA.astro';
import PetsIllustrationTA from '@/components/PetsIllustrationTA.astro';
import CareRailTA from '@/components/CareRailTA.astro';
import ContactBandTA from '@/components/ContactBandTA.astro';
import FaqTA from '@/components/FaqTA.astro';
---
<PageLayoutTA title="Hospital veterinario 24 horas en Dosquebradas" description="Hospital Veterinario de Santa Mónica: urgencias, consulta, diagnóstico, cirugía y hospitalización. Atención las 24 horas en Dosquebradas, Risaralda." active="/">
  <section class="home-hero section-shell" aria-label="Cuidado veterinario en Santa Mónica"><div class="hero-copy"><ActionHeaderTA eyebrow="Bienestar que se acompaña" title="Su bienestar. Tu tranquilidad." description="Cuidamos a quienes hacen parte de tu familia. Atención veterinaria cercana, con empatía para ellos y para ti, a cualquier hora."><Fragment slot="title">Su bienestar.<br/><span>Tu tranquilidad.</span></Fragment></ActionHeaderTA><div class="hero-actions reveal"><a class="button button-primary" href="tel:+573215665926"><IconTA name="phone" size={19}/>Llamar al hospital<IconTA name="arrow" size={18}/></a><a class="text-link" href="/nuestros-servicios/">Ver servicios<IconTA name="arrow" size={18}/></a></div><div class="hero-local-note reveal"><span class="local-note-icon"><IconTA name="pin" size={20}/></span><p>Santa Mónica, Dosquebradas<br/><strong>Estamos cerca de ti.</strong></p></div></div><HeroCareTA/></section>
  <div class="care-story"><CareRailTA/>
    <section class="access-strip section-shell" aria-label="Atención del hospital"><div class="access-item reveal"><IconTA name="clock" size={25}/><span><strong>24 horas</strong><small>Los 7 días de la semana</small></span></div><div class="access-item reveal"><IconTA name="stethoscope" size={25}/><span><strong>Consulta general</strong><small>Sin cita, por orden de llegada</small></span></div><div class="access-item reveal"><IconTA name="pin" size={25}/><span><strong>Carrera 19 # 17 B11</strong><small>Santa Mónica · Dosquebradas</small></span></div><a href="/contactanos/" class="access-link" aria-label="Ver información de contacto"><IconTA name="arrow" size={24}/></a></section>
    <section class="care-intro section-shell" aria-labelledby="care-title" data-care-node><div class="section-kicker reveal"><span>01</span><p class="eyebrow">Un mismo vínculo. Un cuidado completo.</p></div><div class="care-intro-heading reveal"><h2 id="care-title">Ellos no pueden decirlo todo.<br/><span>Por eso, los escuchamos distinto.</span></h2><p>Una mirada clínica, un trato cercano y un equipo que entiende lo importante que es cada animal en tu vida.</p></div><ServicePhotosPreviewTA/><div class="care-columns"><article class="care-service urgent-service reveal"><div class="service-small-top"><span>CUANDO MÁS NOS NECESITAS</span><IconTA name="plus" size={24}/></div><span class="urgent-number">24<span>/</span>7</span><h3>Urgencias veterinarias</h3><p>El hospital está abierto las 24 horas. Si necesitas atención, comunícate con nuestro equipo.</p><a class="text-link" href="tel:+573215665926">Llamar ahora<IconTA name="arrow" size={18}/></a></article><article class="care-service diagnostic-service reveal"><PetsIllustrationTA variant="diagnostic"/><h3>Entender para cuidar.</h3><p>Consulta, radiografía, laboratorio y ecografía especializada dentro de nuestro catálogo de servicios.</p><a class="text-link" href="/nuestros-servicios/">Explorar el diagnóstico<IconTA name="arrow" size={18}/></a></article><article class="care-service hospital-service reveal"><PetsIllustrationTA variant="hospital"/><h3>Acompañar su proceso.</h3><p>Cirugía, hospitalización, medicina preventiva y farmacia veterinaria en un mismo hospital.</p><a class="text-link" href="/nuestros-servicios/">Conocer el cuidado<IconTA name="arrow" size={18}/></a></article></div></section>
    <section class="hospital-intro section-shell" aria-labelledby="hospital-title" data-care-node><figure class="hospital-team-photo reveal"><img src="/images/equipo-hospital.webp" srcset="/images/equipo-hospital-480.webp 480w, /images/equipo-hospital-960.webp 960w, /images/equipo-hospital-1600.webp 1600w" sizes="(max-width:760px) 90vw, 52vw" width="1600" height="1067" alt="Equipo del Hospital Veterinario de Santa Mónica con perros en la recepción" loading="lazy"/><figcaption><IconTA name="heart" size={18}/><span>Personas que cuidan. Vínculos que importan.</span></figcaption></figure><div class="hospital-intro-copy reveal"><p class="eyebrow">02 / Conoce nuestro hospital</p><h2 id="hospital-title">La atención es médica.<br/><span>El trato, humano.</span></h2><p>En Santa Mónica trabajamos por el bienestar de los animales y la tranquilidad de sus cuidadores. Nuestra misión, visión y valores dan sentido a la manera en que acompañamos cada proceso.</p><div class="hospital-promise"><IconTA name="shield" size={30}/><p>Empatía con quien cuida.<br/><strong>Compromiso con quien necesita cuidado.</strong></p></div><a class="button button-outline" href="/sobre-nosotros/">Descubre Santa Mónica<IconTA name="arrow" size={19}/></a></div></section>
    <section class="services-invitation section-shell" aria-labelledby="services-title" data-care-node><div class="services-invitation-copy reveal"><p class="eyebrow">03 / Cada necesidad tiene su camino</p><h2 id="services-title">Del primer contacto<br/><span>al cuidado que necesitan.</span></h2><p>Conoce nuestros 12 servicios y encuentra la información que te ayuda a dar el siguiente paso.</p><a class="button button-primary" href="/nuestros-servicios/">Encuentra un servicio<IconTA name="arrow" size={19}/></a></div><div class="care-path-map reveal" aria-label="Áreas de atención del hospital"><svg viewBox="0 0 560 320" fill="none" aria-hidden="true"><path d="M53 80h175c93 0 44 160 126 160h154" stroke="#b6d7cc" stroke-width="2"/><path d="M53 80h175c93 0 44 160 126 160h154" stroke="#027b76" stroke-width="2" stroke-dasharray="3 8"/><circle cx="58" cy="80" r="29" fill="white" stroke="#027b76"/><path d="M47 80h22M58 69v22" stroke="#027b76" stroke-width="2"/><circle cx="271" cy="137" r="29" fill="#e5f3ed" stroke="#027b76"/><path d="m258 136 8 7 6-16 6 18 7-10" stroke="#027b76" stroke-width="2" stroke-linecap="round"/><circle cx="500" cy="240" r="29" fill="#027b76"/><path d="m489 240 7 7 14-17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><div class="care-path-label path-label-one"><span>01 / ATENCIÓN</span><strong>Consulta y urgencias</strong></div><div class="care-path-label path-label-two"><span>02 / DIAGNÓSTICO</span><strong>Conocer lo que pasa</strong></div><div class="care-path-label path-label-three"><span>03 / ACOMPAÑAMIENTO</span><strong>Cuidar su proceso</strong></div></div></section>
    <section class="stories-section section-shell" aria-labelledby="stories-title" data-care-node><div class="section-kicker reveal"><span>04</span><p class="eyebrow">Lo que se vive también se comparte</p></div><div class="stories-heading reveal"><h2 id="stories-title">Detrás de cada cuidado,<br/><span>hay una historia.</span></h2><p>Reseñas y cartas que forman parte del archivo del hospital. Conoce las experiencias que sus cuidadores han compartido.</p></div><div class="stories-links"><a class="story-link reveal" href="/testimonios/"><span class="story-link-icon"><IconTA name="heart" size={32}/></span><span><small>VOCES DE CUIDADORES</small><strong>Reseñas del hospital</strong><span>Una mirada a sus experiencias.</span></span><IconTA name="arrow" size={25}/></a><a class="story-link reveal" href="/testimonios/#cartas"><span class="story-link-icon"><IconTA name="mail" size={32}/></span><span><small>CARTAS QUE SE QUEDAN</small><strong>Athena y Lucas</strong><span>Recuerdos compartidos con el equipo.</span></span><IconTA name="arrow" size={25}/></a></div></section>
    <FaqTA/>
  </div>
  <ContactBandTA/>
</PageLayoutTA>

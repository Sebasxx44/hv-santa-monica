---
import PageLayoutTA from '@/components/PageLayoutTA.astro';
import ActionHeaderTA from '@/components/ActionHeaderTA.astro';
import ContactBandTA from '@/components/ContactBandTA.astro';
import IconTA from '@/components/IconTA.astro';
import { archiveEntry } from '@/data/archive';
---
<PageLayoutTA title="Blog de actualidad" description="Novedades y orientación para encontrar los servicios y canales de atención del Hospital Veterinario Santa Mónica." active="/blog-de-actualidad/">
  <div>
    <section class="journal-hero section-shell">
      <div><ActionHeaderTA class="journal-heading" eyebrow="BLOG DE ACTUALIDAD" title="Siempre cerca. También aquí." description="Un espacio para las novedades del hospital y la información que necesitas para encontrarnos."/><div class="journal-hero-links"><a class="button button-primary" href="/nuestros-servicios/">Conoce nuestros servicios <IconTA name="arrow" size={18}/></a><a class="text-link" href="#archivo">Explorar el archivo <IconTA name="chevron" size={17}/></a></div></div>
      <aside class="journal-hours"><span class="journal-hours-icon"><IconTA name="clock" size={32}/></span><p class="eyebrow">CUANDO NOS NECESITES</p><strong>Las 24 horas.<br/>Los 7 días.</strong><p>Encuentra nuestros canales de atención y la ubicación del hospital en Santa Mónica, Dosquebradas.</p><a href="/contactanos/">Cómo contactarnos <IconTA name="arrow" size={18}/></a><div class="journal-paw" aria-hidden="true"><IconTA name="paw" size={120}/></div></aside>
    </section>
    <section class="journal-guide section-shell" aria-labelledby="journal-guide-title"><div><p class="eyebrow">INFORMACIÓN A MANO</p><h2 id="journal-guide-title">Menos vueltas.<br/>Más claridad.</h2><p>Para conocer la atención disponible o conversar sobre una visita, empieza por aquí.</p></div><div class="journal-guide-links"><a href="/nuestros-servicios/"><span><small>01 / ATENCIÓN</small><strong>Un equipo, distintos servicios.</strong><span>Consulta la atención general, las especialidades y los servicios de apoyo.</span></span><IconTA name="arrow" size={24}/></a><a href="/contactanos/"><span><small>02 / ENCUÉNTRANOS</small><strong>Conversemos sobre tu visita.</strong><span>Teléfono, WhatsApp, correo y la dirección del hospital en un solo lugar.</span></span><IconTA name="arrow" size={24}/></a></div></section>
    <section id="archivo" class="journal-archive section-shell" aria-labelledby="journal-archive-title"><div class="journal-archive-header"><div><p class="eyebrow">DEL ARCHIVO DEL SITIO</p><h2 id="journal-archive-title">El primer registro.</h2></div><p>Conservamos la entrada de bienvenida de la versión original. Todavía no hay artículos clínicos publicados en este archivo.</p></div><article class="journal-entry"><div class="journal-entry-mark" aria-hidden="true"><IconTA name="paw" size={56}/><span>01 / ARCHIVO</span></div><div class="journal-entry-copy"><p><time datetime={archiveEntry.date}>{archiveEntry.dateLabel}</time><span aria-hidden="true">·</span>Entrada de bienvenida</p><h3><a href={archiveEntry.path}>{archiveEntry.title}</a></h3><p>{archiveEntry.summary}</p><a class="text-link" href={archiveEntry.path}>Leer el registro original <IconTA name="arrow" size={18}/></a></div><a class="journal-entry-category" href={archiveEntry.categoryPath}>{archiveEntry.category}<IconTA name="arrow" size={14}/></a></article></section>
  </div>
  <ContactBandTA/>
</PageLayoutTA>
<style>
.journal-hero{display:grid;grid-template-columns:1.35fr .65fr;align-items:center;gap:9%;padding-top:65px;padding-bottom:80px}.journal-hero :global(.journal-heading){padding:0;max-width:780px}.journal-hero :global(.journal-heading h1){font-size:clamp(48px,5.4vw,76px);line-height:1.03;letter-spacing:-.055em}.journal-hero :global(.action-description){max-width:510px;font-size:16px;line-height:1.8}.journal-hero-links{display:flex;align-items:center;gap:28px;flex-wrap:wrap;margin-top:32px}.journal-hero-links>.text-link{font-size:13px;display:flex;align-items:center;gap:12px}.journal-hours{position:relative;overflow:hidden;isolation:isolate;background:#e8f5f2;border-radius:24px;padding:35px 34px;min-height:360px}.journal-hours-icon{display:grid;place-items:center;width:62px;height:62px;background:white;border-radius:50%;color:#027b76;margin-bottom:26px}.journal-hours>.eyebrow{font-size:11px;letter-spacing:.08em;margin-bottom:14px}.journal-hours>strong{font-family:var(--font-display,'Outfit'),sans-serif;font-size:38px;line-height:1.13;font-weight:500;letter-spacing:-1.3px;color:#027b76}.journal-hours>p:not(.eyebrow){font-size:14px;line-height:1.8;max-width:270px;margin-top:18px;color:#50666c}.journal-hours>a{display:flex;align-items:center;justify-content:space-between;gap:20px;position:relative;margin-top:27px;padding-top:20px;border-top:1px solid #027b7626;font-weight:700;font-size:13px;color:#027b76}.journal-paw{position:absolute;right:-32px;top:70px;color:#027b76;opacity:.055;transform:rotate(-22deg);z-index:-1}.journal-guide{display:grid;grid-template-columns:.8fr 1.2fr;gap:10%;padding-block:65px;background:#f2f6f5;border-radius:24px}.journal-guide .eyebrow{font-size:11px}.journal-guide h2{font-size:42px;line-height:1.1;margin-top:20px;font-weight:500;letter-spacing:-1.4px}.journal-guide>div>p:last-child{font-size:15px;line-height:1.8;color:#64777d;margin-top:21px;max-width:330px}.journal-guide-links>a{display:flex;gap:22px;align-items:center;justify-content:space-between;padding-block:22px}.journal-guide-links>a+a{border-top:1px solid #2c3d491c}.journal-guide-links>a>span{display:block}.journal-guide-links small{font-size:11px;letter-spacing:.09em;color:#027b76}.journal-guide-links strong{display:block;font-size:21px;font-weight:600;margin-top:10px;letter-spacing:-.3px}.journal-guide-links a>span>span{display:block;font-size:14px;line-height:1.8;color:#64777d;max-width:440px;margin-top:10px}.journal-guide-links :global(svg){flex-shrink:0;color:#027b76}.journal-archive{padding-block:85px}.journal-archive-header{display:flex;align-items:end;justify-content:space-between;gap:45px;margin-bottom:32px}.journal-archive-header .eyebrow{font-size:11px}.journal-archive-header h2{font-size:42px;letter-spacing:-1.4px;margin-top:17px;font-weight:500}.journal-archive-header>p{font-size:14px;line-height:1.8;color:#64777d;max-width:350px}.journal-entry{display:grid;grid-template-columns:180px 1fr auto;gap:34px;align-items:center;padding:25px;border:1px solid #dce7e5;border-radius:20px}.journal-entry-mark{height:170px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:22px;background:#edf7f5;border-radius:12px;color:#027b76}.journal-entry-mark>span{font-size:11px;letter-spacing:.1em}.journal-entry-copy>p:first-child{display:flex;flex-wrap:wrap;gap:12px;color:#75848a;font-size:12px}.journal-entry h3{font-size:30px;letter-spacing:-.9px;margin-top:10px;font-weight:500}.journal-entry-copy>p:nth-of-type(2){font-size:14px;line-height:1.8;color:#64777d;max-width:490px;margin-top:10px}.journal-entry-copy>.text-link{display:flex;align-items:center;gap:16px;color:#027b76;font-weight:700;font-size:13px;margin-top:18px}.journal-entry-category{align-self:start;display:flex;align-items:center;gap:9px;padding:9px 12px;font-size:11px;border-radius:20px;background:#f1f5f4;color:#526c72}.journal-entry a:hover{color:#027b76}@media(max-width:1000px){.journal-hero{gap:6%;grid-template-columns:1.15fr .85fr}.journal-hero :global(.journal-heading h1){font-size:57px}.journal-hours{padding:28px}.journal-hours>strong{font-size:34px}.journal-hero-links{gap:21px}.journal-guide{gap:7%;grid-template-columns:.8fr 1.2fr}.journal-entry{grid-template-columns:145px 1fr;gap:25px}.journal-entry-category{display:none}.journal-entry-mark{height:180px}.journal-archive-header{gap:30px}.journal-archive-header>p{max-width:300px}}@media(max-width:700px){.journal-hero{grid-template-columns:1fr;gap:38px;padding-top:40px;padding-bottom:45px}.journal-hero :global(.journal-heading h1){font-size:47px;letter-spacing:-2px}.journal-hero :global(.action-description){font-size:15px}.journal-hero-links{margin-top:25px;gap:22px}.journal-hours{min-height:0;padding:28px}.journal-hours-icon{width:50px;height:50px;margin-bottom:20px}.journal-hours>strong{font-size:34px}.journal-hours>p:not(.eyebrow){max-width:100%;font-size:14px}.journal-hours>a{margin-top:23px}.journal-guide{grid-template-columns:1fr;gap:20px;padding-block:38px;border-radius:0}.journal-guide h2{font-size:36px;margin-top:16px}.journal-guide>div>p:last-child{font-size:14px;max-width:100%}.journal-guide-links strong{font-size:20px}.journal-guide-links a>span>span{font-size:14px}.journal-archive{padding-block:48px}.journal-archive-header{display:block;margin-bottom:25px}.journal-archive-header h2{font-size:35px;margin-top:16px}.journal-archive-header>p{margin-top:20px;max-width:100%;font-size:14px}.journal-entry{grid-template-columns:1fr;padding:19px;gap:22px}.journal-entry-mark{height:145px;gap:15px}.journal-entry h3{font-size:28px}.journal-entry-copy>p:first-child{font-size:11px;gap:9px}.journal-entry-copy>p:nth-of-type(2){font-size:14px}}
</style>

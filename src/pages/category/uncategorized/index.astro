---
import PageLayoutTA from '@/components/PageLayoutTA.astro';
import ActionHeaderTA from '@/components/ActionHeaderTA.astro';
import IconTA from '@/components/IconTA.astro';
import { archiveEntry } from '@/data/archive';
---
<PageLayoutTA title="Uncategorized · Archivo" description="Categoría original de WordPress que conserva la entrada de bienvenida del archivo del sitio." active="/blog-de-actualidad/" robots="noindex, follow">
  <div class="category-page section-shell"><ActionHeaderTA class="category-heading" eyebrow="CATEGORÍA DEL ARCHIVO ORIGINAL" title="Uncategorized" description="La categoría que acompañó la primera entrada del sitio. Un registro de bienvenida, sin artículos clínicos."/><section class="category-list" aria-label="Entradas de esta categoría"><article><div class="category-marker" aria-hidden="true"><IconTA name="paw" size={49}/></div><div><p class="category-date"><time datetime={archiveEntry.date}>{archiveEntry.dateLabel}</time><span> / ARCHIVO</span></p><h2><a href={archiveEntry.path}>{archiveEntry.title}</a></h2><p>{archiveEntry.summary}</p><a class="text-link" href={archiveEntry.path}>Leer la entrada <IconTA name="arrow" size={17}/></a></div></article></section><a class="category-back text-link" href="/blog-de-actualidad/">Volver al blog de actualidad <IconTA name="arrow" size={17}/></a></div>
</PageLayoutTA>
<style>
.category-page{padding-top:55px;padding-bottom:85px}.category-page :global(.category-heading){padding:0;max-width:900px}.category-page :global(.category-heading h1){font-size:clamp(44px,5.7vw,72px);line-height:1.07;letter-spacing:-.05em;overflow-wrap:anywhere}.category-page :global(.action-description){font-size:16px;line-height:1.8;max-width:620px}.category-list{margin-top:40px;padding-top:35px;border-top:1px solid #dfe8e6}.category-list article{display:grid;grid-template-columns:180px 1fr;gap:35px;align-items:center;max-width:940px}.category-marker{display:grid;place-items:center;min-height:180px;border-radius:20px;background:#eaf6f3;color:#027b76}.category-date{font-size:12px;color:#75868d}.category-date>span{font-size:11px;margin-left:12px;letter-spacing:.04em}.category-list h2{font-size:34px;font-weight:500;letter-spacing:-1px;margin-top:12px}.category-list article>div>p:not(.category-date){font-size:15px;line-height:1.9;color:#5b727c;max-width:570px;margin-top:12px}.category-list .text-link,.category-back{display:inline-flex;align-items:center;gap:18px;color:#027b76;font-size:13px;font-weight:700}.category-list .text-link{margin-top:21px}.category-back{margin-top:42px;padding-top:27px;border-top:1px solid #dfe8e6;width:100%}@media(max-width:700px){.category-page{padding-top:35px;padding-bottom:50px}.category-page :global(.category-heading h1){font-size:41px}.category-page :global(.action-description){font-size:15px}.category-list{margin-top:30px;padding-top:25px}.category-list article{grid-template-columns:1fr;gap:24px}.category-marker{min-height:150px}.category-list h2{font-size:30px}.category-list article>div>p:not(.category-date){font-size:14px}.category-date{font-size:11px}.category-date>span{font-size:11px;margin-left:8px}}
</style>

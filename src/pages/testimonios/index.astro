---
import PageLayoutTA from '@/components/PageLayoutTA.astro';
import ActionHeaderTA from '@/components/ActionHeaderTA.astro';
import ContactBandTA from '@/components/ContactBandTA.astro';
import IconTA from '@/components/IconTA.astro';
import { testimonialReviews, familyLetters } from '@/data/archive';
---
<PageLayoutTA title="Testimonios" description="Reseñas y cartas compartidas por las familias en el archivo del Hospital Veterinario Santa Mónica. Consulta sus evidencias originales." active="/testimonios/">
  <div>
    <section class="testimonials-hero section-shell"><div><ActionHeaderTA class="testimonials-heading" eyebrow="TESTIMONIOS" title="La confianza tiene muchas voces." description="Detrás de cada paciente hay una familia. Estas son algunas de las experiencias que nos han compartido."/><nav class="testimonials-jump" aria-label="Explorar testimonios"><a class="button button-primary" href="#resenas">Leer las reseñas <IconTA name="arrow" size={18}/></a><a class="text-link" href="#cartas">Cartas de las familias <IconTA name="chevron" size={17}/></a></nav></div><aside class="testimonials-note"><div class="testimonials-note-icon"><IconTA name="heart" size={32}/></div><p class="eyebrow">MUCHO MÁS QUE UNA VISITA</p><h2>Cuidarlos también<br/>es acompañarte.</h2><p>Atención, cariño y apoyo a las familias: los temas que aparecen en sus mensajes.</p><div><span aria-hidden="true"></span><p>Reseñas y recuerdos del archivo del hospital.</p></div><div class="testimonials-note-paw" aria-hidden="true"><IconTA name="paw" size={150}/></div></aside></section>
    <section id="resenas" class="testimonials-reviews section-shell" aria-labelledby="testimonials-reviews-title"><div class="testimonials-section-heading"><div><p class="eyebrow">SUS EXPERIENCIAS, EN PRIMERA PERSONA</p><h2 id="testimonials-reviews-title">Gracias por contarnos.</h2></div><p>Resúmenes de 13 reseñas de Google publicadas en el sitio original. Puedes abrir cada captura para leer el mensaje completo.</p></div><div class="testimonials-grid">{testimonialReviews.map((review) => <article class="testimonial-card"><header><span class="testimonial-avatar" aria-hidden="true">{review.initials}</span><div><h3>{review.author}</h3><p>Reseña compartida en Google</p></div></header><div class="testimonial-rating" role="img" aria-label="5 de 5 estrellas, tal como aparece en esta captura">{Array.from({ length: 5 }, () => <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="m12 2.5 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9Z" fill="currentColor"/></svg>)}</div><p class="testimonial-summary">{review.summary}</p><p class="testimonial-date">En la captura: {review.relativeDate.toLocaleLowerCase('es')}</p><a class="testimonial-evidence" href={review.image} data-testimonial-open={review.id} aria-label={`Ver reseña original de ${review.author}`}><span>Ver reseña original</span><IconTA name="plus" size={18}/></a></article>)}</div><p class="testimonials-archive-note">Las fechas son las que muestran las capturas del archivo. Esta selección no representa una calificación global actual de Google. Los textos anteriores son resúmenes, no citas literales.</p></section>
    <section id="cartas" class="testimonials-letters section-shell" aria-labelledby="testimonials-letters-title"><div class="testimonials-section-heading"><div><p class="eyebrow">MENSAJES QUE SE QUEDAN</p><h2 id="testimonials-letters-title">De su casa a la nuestra.</h2></div><p>Cartas y recuerdos que las familias de Athena y Lucas compartieron con el hospital.</p></div><div class="testimonials-letters-grid">{familyLetters.map((letter) => <article class="family-letter"><div class="family-letter-top"><span><IconTA name="heart" size={21}/></span><p>{letter.family}</p></div><h3>{letter.title}</h3><p>{letter.summary}</p><div class="family-letter-gallery">{letter.evidence.map((item) => <a href={item.image} data-testimonial-open={item.id} aria-label={`Ver original: ${item.title}`}><img src={item.thumbnail} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async"/><span>{item.title}<IconTA name="plus" size={16}/></span></a>)}</div><p class="family-letter-caption">{letter.id === 'athena' ? 'Dos fotografías de una misma carta de agradecimiento.' : 'Una ilustración de Lucas y la carta de su familia.'}</p></article>)}</div></section>
  </div>
  <ContactBandTA/>
  <dialog class="testimonial-dialog" data-testimonial-dialog aria-labelledby="testimonial-viewer-title" aria-describedby="testimonial-viewer-description"><div class="testimonial-dialog-header"><span class="eyebrow">DEL ARCHIVO ORIGINAL</span><button type="button" data-viewer-close aria-label="Cerrar imagen" autofocus><IconTA name="close" size={22}/></button></div><div class="testimonial-dialog-image"><img data-viewer-image alt=""/></div><div class="testimonial-dialog-caption"><div aria-live="polite" aria-atomic="true"><h2 id="testimonial-viewer-title" data-viewer-title>Imagen del archivo</h2><p id="testimonial-viewer-description" data-viewer-description></p></div><nav aria-label="Recorrer imágenes del archivo"><button type="button" data-viewer-previous aria-label="Imagen anterior"><span><IconTA name="arrow" size={19}/></span></button><span data-viewer-counter>1 / 17</span><button type="button" data-viewer-next aria-label="Imagen siguiente"><IconTA name="arrow" size={19}/></button></nav></div><div class="testimonial-dialog-footer"><a data-viewer-source href="https://www.hvdesantamonica.com.co/testimonios/" target="_blank" rel="noopener noreferrer">Abrir imagen original <IconTA name="arrow" size={15}/></a><p>También puedes usar las flechas del teclado. Esc para cerrar.</p></div></dialog>
</PageLayoutTA>
<script>
import { initTestimonials } from '@/composables/testimonials/initTestimonials';
initTestimonials();
</script>
<style>
.testimonials-hero{display:grid;grid-template-columns:1.3fr .7fr;gap:9%;align-items:center;padding-top:65px;padding-bottom:80px}.testimonials-hero :global(.testimonials-heading){padding:0;max-width:760px}.testimonials-hero :global(.testimonials-heading h1){font-size:clamp(49px,5.3vw,75px);line-height:1.04;letter-spacing:-.055em}.testimonials-hero :global(.action-description){font-size:16px;line-height:1.85;max-width:480px}.testimonials-jump{display:flex;gap:25px;align-items:center;flex-wrap:wrap;margin-top:32px}.testimonials-jump>.text-link{display:flex;align-items:center;gap:12px;font-size:13px}.testimonials-note{position:relative;isolation:isolate;overflow:hidden;background:#027b76;color:white;border-radius:24px;padding:35px;min-height:350px}.testimonials-note-icon{width:58px;height:58px;display:grid;place-items:center;border:1px solid #ffffff42;border-radius:50%;margin-bottom:27px}.testimonials-note>.eyebrow{font-size:11px;letter-spacing:.065em;color:#c7f0e7}.testimonials-note h2{font-size:34px;line-height:1.16;letter-spacing:-1px;font-weight:500;margin-top:17px}.testimonials-note>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#d7eee8;max-width:270px;margin-top:20px}.testimonials-note>div:nth-last-child(2){display:flex;align-items:center;gap:10px;border-top:1px solid #ffffff30;margin-top:25px;padding-top:20px}.testimonials-note>div:nth-last-child(2)>span{width:6px;height:6px;flex-shrink:0;border-radius:50%;background:#82e6d3}.testimonials-note>div:nth-last-child(2)>p{font-size:11px;line-height:1.6;color:#d7eee8}.testimonials-note-paw{position:absolute;right:-45px;top:80px;transform:rotate(-18deg);opacity:.055;z-index:-1}.testimonials-reviews{padding-top:15px;padding-bottom:65px;scroll-margin-top:120px}.testimonials-section-heading{display:flex;align-items:end;justify-content:space-between;gap:45px;margin-bottom:32px}.testimonials-section-heading .eyebrow{font-size:11px;letter-spacing:.08em}.testimonials-section-heading h2{font-size:42px;font-weight:500;letter-spacing:-1.4px;margin-top:17px;line-height:1.1}.testimonials-section-heading>p{font-size:14px;line-height:1.8;color:#687c82;max-width:370px}.testimonials-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.testimonial-card{display:flex;flex-direction:column;border:1px solid #dce7e5;border-radius:20px;padding:27px 25px;background:#fff}.testimonial-card>header{display:flex;align-items:center;gap:13px;min-height:46px}.testimonial-avatar{width:44px;height:44px;border-radius:50%;flex-shrink:0;display:grid;place-items:center;background:#e7f4f1;color:#027b76;font-size:14px;font-weight:700}.testimonial-card h3{font-size:15px;font-weight:700;line-height:1.5;overflow-wrap:anywhere}.testimonial-card>header p{font-size:11px;line-height:1.6;color:#7c8c91;margin-top:3px}.testimonial-rating{display:flex;gap:4px;color:#027b76;margin-top:23px}.testimonial-summary{font-size:15px;line-height:1.9;color:#4c626b;margin-top:15px;margin-bottom:19px}.testimonial-date{font-size:11px;line-height:1.7;color:#7a8a91;margin-top:auto}.testimonial-evidence{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12px;font-weight:700;color:#027b76;border-top:1px solid #dce7e5;margin-top:18px;padding-top:17px}.testimonial-evidence :global(svg){flex-shrink:0;transition:transform .2s}.testimonial-evidence:hover :global(svg){transform:rotate(90deg)}.testimonials-archive-note{font-size:11px;line-height:1.85;color:#78898f;max-width:870px;margin-top:26px}.testimonials-letters{padding-top:55px;padding-bottom:85px;border-top:1px solid #e0e8e6;scroll-margin-top:115px}.testimonials-letters-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px}.family-letter{padding:32px;background:#f0f6f4;border-radius:22px;min-width:0}.family-letter-top{display:flex;align-items:center;gap:13px}.family-letter-top>span{display:grid;place-items:center;background:#fff;width:43px;height:43px;flex-shrink:0;border-radius:50%;color:#027b76}.family-letter-top>p{font-size:13px;color:#027b76;font-weight:700;line-height:1.6}.family-letter h3{font-size:31px;line-height:1.15;letter-spacing:-.9px;font-weight:500;margin-top:25px;max-width:330px}.family-letter>p:not(.family-letter-caption){font-size:14px;line-height:1.9;color:#60777f;margin-top:15px;min-height:54px}.family-letter-gallery{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:25px}.family-letter-gallery>a{min-width:0;background:white;overflow:hidden;border-radius:12px;border:1px solid #dce7e5}.family-letter-gallery img{height:170px;aspect-ratio:1;object-fit:cover;object-position:center 22%;width:100%;display:block;transition:transform .25s}.family-letter-gallery>a:hover img{transform:scale(1.035)}.family-letter-gallery>a>span{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 12px;font-size:11px;line-height:1.6;color:#027b76}.family-letter-gallery :global(svg){flex-shrink:0}.family-letter-caption{font-size:11px;line-height:1.8;color:#7a8d92;margin-top:17px}.testimonial-dialog{width:min(1060px,calc(100% - 44px));max-height:calc(100dvh - 44px);margin:auto;border:none;border-radius:23px;padding:0;background:#f8fbfa;color:#2c3d49;box-shadow:0 30px 100px #102b3559;overscroll-behavior:contain}.testimonial-dialog::backdrop{background:#122c37bf;backdrop-filter:blur(7px)}.testimonial-dialog-header{display:flex;justify-content:space-between;align-items:center;padding:18px 25px;border-bottom:1px solid #dce7e5}.testimonial-dialog-header>.eyebrow{font-size:11px;letter-spacing:.08em;color:#027b76}.testimonial-dialog button{display:grid;place-items:center;border:1px solid #d2e3df;background:white;color:#027b76;min-width:42px;min-height:42px;border-radius:50%;cursor:pointer}.testimonial-dialog button:hover{background:#eaf6f2}.testimonial-dialog-image{display:grid;place-items:center;min-height:200px;padding:25px;background:#e9f0ee}.testimonial-dialog-image>img{display:block;width:auto;height:auto;max-width:100%;max-height:55dvh;object-fit:contain;box-shadow:0 7px 30px #193a4420}.testimonial-dialog-caption{display:flex;justify-content:space-between;align-items:center;gap:25px;padding:22px 25px}.testimonial-dialog-caption>div{min-width:0}.testimonial-dialog-caption h2{font-size:22px;line-height:1.3;letter-spacing:-.4px;font-weight:500}.testimonial-dialog-caption p{font-size:13px;line-height:1.8;color:#6a7d84;margin-top:8px;max-width:650px}.testimonial-dialog-caption>nav{display:flex;align-items:center;gap:17px;flex-shrink:0}.testimonial-dialog-caption>nav>span{font-size:12px;font-variant-numeric:tabular-nums;min-width:40px;text-align:center}.testimonial-dialog-caption>nav>button:first-child>span{transform:rotate(180deg)}.testimonial-dialog-footer{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 25px 22px}.testimonial-dialog-footer>a{display:flex;align-items:center;gap:12px;color:#027b76;font-size:12px;font-weight:700}.testimonial-dialog-footer>p{font-size:11px;line-height:1.7;color:#7a8a91}@media(max-width:1000px){.testimonials-hero{gap:6%;grid-template-columns:1.1fr .9fr}.testimonials-hero :global(.testimonials-heading h1){font-size:55px}.testimonials-note{padding:29px}.testimonials-note h2{font-size:30px}.testimonials-jump{gap:22px}.testimonials-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.testimonials-section-heading{gap:30px}.testimonials-section-heading h2{font-size:37px}.testimonials-section-heading>p{max-width:310px}.family-letter{padding:25px}.family-letter h3{font-size:29px}.family-letter-gallery{gap:12px}.family-letter-gallery img{height:145px}.family-letter-gallery>a>span{font-size:11px;padding:11px 10px}}@media(max-width:700px){.testimonials-hero{grid-template-columns:1fr;gap:35px;padding-top:40px;padding-bottom:50px}.testimonials-hero :global(.testimonials-heading h1){font-size:47px;letter-spacing:-2px}.testimonials-hero :global(.action-description){font-size:15px}.testimonials-jump{gap:23px;margin-top:25px}.testimonials-jump>.text-link{font-size:13px}.testimonials-note{min-height:0;padding:28px}.testimonials-note-icon{width:49px;height:49px;margin-bottom:22px}.testimonials-note h2{font-size:32px}.testimonials-note>p:not(.eyebrow){max-width:100%;font-size:14px}.testimonials-note>div:nth-last-child(2){margin-top:22px}.testimonials-reviews{padding-top:0;padding-bottom:40px}.testimonials-section-heading{display:block;margin-bottom:26px}.testimonials-section-heading .eyebrow{font-size:11px}.testimonials-section-heading h2{font-size:35px;margin-top:16px;letter-spacing:-1.2px}.testimonials-section-heading>p{max-width:100%;font-size:14px;margin-top:18px}.testimonials-grid{grid-template-columns:1fr;gap:17px}.testimonial-card{padding:24px}.testimonial-card h3{font-size:15px}.testimonial-summary{font-size:15px}.testimonials-archive-note{font-size:11px;margin-top:23px}.testimonials-letters{padding-top:38px;padding-bottom:48px}.testimonials-letters-grid{grid-template-columns:1fr;gap:22px}.family-letter{padding:24px}.family-letter h3{font-size:30px;max-width:100%;margin-top:22px}.family-letter>p:not(.family-letter-caption){min-height:0}.family-letter-gallery img{height:160px}.testimonial-dialog{width:calc(100% - 24px);max-height:calc(100dvh - 24px);border-radius:18px}.testimonial-dialog-header{padding:12px 16px}.testimonial-dialog-header>.eyebrow{font-size:11px}.testimonial-dialog-image{padding:15px;min-height:150px}.testimonial-dialog-image>img{max-height:48dvh}.testimonial-dialog-caption{display:block;padding:18px}.testimonial-dialog-caption h2{font-size:21px}.testimonial-dialog-caption>nav{margin-top:18px;justify-content:center}.testimonial-dialog-footer{display:block;padding:0 18px 20px}.testimonial-dialog-footer>p{margin-top:13px;max-width:260px}.testimonial-dialog-caption p{font-size:13px}}@media(max-width:380px){.testimonials-hero :global(.testimonials-heading h1){font-size:42px}.family-letter{padding:20px}.family-letter-gallery{gap:9px}.family-letter-gallery img{height:130px}.family-letter-gallery>a>span{font-size:11px;gap:6px;padding:10px 8px}}@media(prefers-reduced-motion:reduce){.testimonial-evidence :global(svg),.family-letter-gallery img{transition:none}}
</style>

---
import PageLayoutTA from '@/components/PageLayoutTA.astro';
import ActionHeaderTA from '@/components/ActionHeaderTA.astro';
import ContactBandTA from '@/components/ContactBandTA.astro';
import IconTA from '@/components/IconTA.astro';
import { archiveEntry } from '@/data/archive';
---
<PageLayoutTA title="Hello world! · Archivo" description={archiveEntry.summary} active="/blog-de-actualidad/">
  <div class="archive-page section-shell"><nav class="archive-breadcrumb" aria-label="Ubicación"><a href="/blog-de-actualidad/">Blog de actualidad</a><IconTA name="chevron" size={13}/><a href={archiveEntry.categoryPath}>{archiveEntry.category}</a></nav><ActionHeaderTA class="archive-heading" eyebrow="ENTRADA DEL ARCHIVO ORIGINAL" title={archiveEntry.title} description="El mensaje que acompañó la primera instalación del sitio."/><div class="archive-meta"><time datetime={archiveEntry.date}>{archiveEntry.dateLabel}</time><span aria-hidden="true">/</span><span>Publicado por <a href="/author/admin/">admin</a></span></div><article class="archive-body"><p class="archive-label">BIENVENIDA DE WORDPRESS</p><p>Esta es la entrada inicial de la instalación original de WordPress. Su mensaje daba la bienvenida al sitio e invitaba a editar o eliminar el contenido de ejemplo para comenzar a publicar.</p><p>Se conserva aquí como parte del archivo. No es un artículo veterinario ni contiene recomendaciones sobre la salud de los animales.</p><details><summary>Leer el mensaje original en inglés</summary><p lang="en">Welcome to WordPress. This is your first post. Edit or delete it, then start writing!</p></details><aside><IconTA name="paw" size={28}/><div><h2>Lo que sí puedes encontrar aquí.</h2><p>Consulta los servicios del hospital o comunícate con nuestro equipo para conocer la atención disponible.</p><div><a href="/nuestros-servicios/">Nuestros servicios <IconTA name="arrow" size={16}/></a><a href="/contactanos/">Contactar al hospital <IconTA name="arrow" size={16}/></a></div></div></aside><a class="text-link archive-back" href="/blog-de-actualidad/">Volver al blog <IconTA name="arrow" size={17}/></a></article></div><ContactBandTA/>
</PageLayoutTA>
<style>
.archive-page{padding-top:42px;padding-bottom:80px}.archive-breadcrumb{display:flex;align-items:center;gap:12px;color:#6b7c83;font-size:12px;margin-bottom:35px}.archive-page :global(.archive-heading){padding:0;max-width:900px}.archive-page :global(.archive-heading h1){font-size:clamp(52px,6vw,78px);line-height:1.05;letter-spacing:-.05em}.archive-page :global(.action-description){font-size:16px;max-width:600px;line-height:1.8}.archive-meta{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:26px;padding-bottom:35px;border-bottom:1px solid #dfe8e6;color:#71838a;font-size:12px}.archive-meta a{color:#027b76}.archive-body{max-width:800px;padding-top:38px}.archive-label{color:#027b76;font-size:11px;font-weight:700;letter-spacing:.1em;margin-bottom:19px}.archive-body>p:not(.archive-label){font-size:16px;line-height:1.95;color:#596e77;margin-bottom:21px}.archive-body details{border-block:1px solid #dfe8e6;padding-block:20px;margin-top:30px}.archive-body summary{cursor:pointer;font-size:14px;font-weight:700;color:#027b76}.archive-body details p{font-size:15px;line-height:1.9;margin-top:18px;color:#637880}.archive-body aside{display:flex;gap:20px;background:#edf7f4;border-radius:18px;padding:30px;margin-top:35px}.archive-body aside>:global(svg){flex-shrink:0;color:#027b76;margin-top:3px}.archive-body h2{font-size:26px;letter-spacing:-.6px;font-weight:500}.archive-body aside p{font-size:14px;line-height:1.9;color:#637880;max-width:560px;margin-top:12px}.archive-body aside>div>div{display:flex;gap:24px;flex-wrap:wrap;margin-top:20px}.archive-body aside a{display:flex;align-items:center;gap:12px;font-size:13px;font-weight:700;color:#027b76}.archive-back{display:inline-flex;align-items:center;gap:20px;font-size:13px;color:#027b76;font-weight:700;margin-top:33px}@media(max-width:700px){.archive-page{padding-top:30px;padding-bottom:48px}.archive-breadcrumb{font-size:11px;gap:8px;margin-bottom:28px}.archive-page :global(.archive-heading h1){font-size:48px}.archive-page :global(.action-description){font-size:15px}.archive-meta{font-size:11px;gap:11px;padding-bottom:27px}.archive-body{padding-top:27px}.archive-body>p:not(.archive-label){font-size:15px}.archive-body aside{padding:23px;gap:15px}.archive-body aside>:global(svg){width:23px}.archive-body h2{font-size:24px}.archive-body aside>div>div{flex-direction:column;gap:17px}}
</style>

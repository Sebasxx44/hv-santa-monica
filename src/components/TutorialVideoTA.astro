---
import IconTA from '@/components/IconTA.astro';
---
<a class="tutorial-video-trigger tutorial-video-fallback" data-tutorial-fallback href="/videos/como-usar-la-web.mp4" target="_blank" rel="noopener noreferrer"><span class="tutorial-play-mark" aria-hidden="true"></span>Cómo usar la web<IconTA name="arrow" size={15}/></a>
<button class="tutorial-video-trigger" type="button" data-tutorial-open aria-haspopup="dialog" aria-controls="tutorial-video-dialog" hidden><span class="tutorial-play-mark" aria-hidden="true"></span>Cómo usar la web</button>
<dialog id="tutorial-video-dialog" class="tutorial-video-dialog" data-tutorial-dialog aria-labelledby="tutorial-video-title" aria-describedby="tutorial-video-description">
  <header class="tutorial-dialog-header"><div><p class="eyebrow">UNA GUÍA PARA ENCONTRAR LO QUE NECESITAS</p><h2 id="tutorial-video-title">Cómo usar la web.</h2></div><button type="button" class="tutorial-close" data-tutorial-close aria-label="Cerrar la guía en video" autofocus><IconTA name="close" size={23}/></button></header>
  <div class="tutorial-video-frame"><video data-tutorial-video data-src="/videos/como-usar-la-web.mp4" width="1280" height="720" controls playsinline muted preload="none" poster="/videos/como-usar-la-web.webp" aria-label="Guía de uso de la web de Santa Mónica" aria-describedby="tutorial-video-description"><p>Puedes <a href="/videos/como-usar-la-web.mp4">abrir la guía en video</a> o explorar <a href="/nuestros-servicios/">los servicios del hospital</a>.</p></video></div>
  <footer class="tutorial-dialog-footer"><p id="tutorial-video-description">Encuentra un servicio, consulta la información de contacto y revisa tu solicitud antes de continuar en WhatsApp. El mensaje no se envía automáticamente.</p><a href="/nuestros-servicios/">Explorar servicios <IconTA name="arrow" size={16}/></a></footer>
  <p class="tutorial-video-status" data-tutorial-status role="status" aria-live="polite"></p>
</dialog>
<script>
import { initTutorialVideo } from '@/composables/tutorialVideo/initTutorialVideo';
initTutorialVideo();
</script>
<style>
.tutorial-video-trigger{display:inline-flex;align-items:center;justify-content:flex-start;gap:10px;flex-basis:100%;width:fit-content;min-height:34px;padding:0;margin-top:-8px;border:0;background:none;color:#027b76;font:inherit;font-size:13px;line-height:1.7;font-weight:600;cursor:pointer;text-align:left}.tutorial-video-trigger:hover{text-decoration:underline;text-underline-offset:4px}.tutorial-video-trigger:focus-visible{outline:3px solid #027b76;outline-offset:5px;border-radius:3px}.tutorial-play-mark{display:grid;place-items:center;width:29px;height:29px;flex-shrink:0;border:1px solid #b9d9cc;border-radius:50%;background:#f1f8f4}.tutorial-play-mark::after{content:"";display:block;width:0;height:0;margin-left:2px;border-top:4px solid transparent;border-bottom:4px solid transparent;border-left:6px solid #027b76}.tutorial-video-fallback>:global(svg){margin-left:1px}.tutorial-video-dialog{width:min(1060px,calc(100% - 36px));max-height:calc(100dvh - 36px);padding:0;margin:auto;border:1px solid #d0e6dc;border-radius:22px;background:#f7fbf9;color:#2c3d49;box-shadow:0 28px 100px #173b485c;overscroll-behavior:contain}.tutorial-video-dialog::backdrop{background:#183d48bd;backdrop-filter:blur(6px)}.tutorial-dialog-header{display:flex;align-items:center;justify-content:space-between;gap:25px;padding:24px 28px}.tutorial-dialog-header .eyebrow{font-size:11px;line-height:1.7;letter-spacing:.07em;color:#027b76}.tutorial-dialog-header h2{font-size:29px;line-height:1.2;letter-spacing:-.7px;font-weight:500;margin-top:9px}.tutorial-close{display:grid;place-items:center;flex-shrink:0;min-width:44px;min-height:44px;padding:10px;border:1px solid #c5ded2;border-radius:50%;background:white;color:#027b76;cursor:pointer}.tutorial-close:hover{background:#e9f5ef}.tutorial-close:focus-visible{outline:3px solid #027b76;outline-offset:4px}.tutorial-video-frame{aspect-ratio:16/9;max-height:62dvh;background:#e5f2eb}.tutorial-video-frame>video{display:block;width:100%;height:100%;max-height:none;object-fit:contain;background:#e5f2eb}.tutorial-video-frame p{font-size:14px;line-height:1.8;padding:25px}.tutorial-video-frame a{text-decoration:underline}.tutorial-dialog-footer{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:24px 28px}.tutorial-dialog-footer>p{max-width:680px;color:#60777c;font-size:14px;line-height:1.8}.tutorial-dialog-footer>a{display:flex;align-items:center;gap:13px;flex-shrink:0;color:#027b76;font-size:13px;font-weight:700}.tutorial-video-status{font-size:13px;line-height:1.8;padding:0 28px 22px;color:#027b76}.tutorial-video-status:empty{display:none}@media(max-width:760px){.tutorial-video-trigger{font-size:13px;gap:10px;margin-top:-3px}.tutorial-video-dialog{width:calc(100% - 24px);max-height:calc(100dvh - 24px);border-radius:20px}.tutorial-dialog-header{padding:20px;gap:17px}.tutorial-dialog-header .eyebrow{font-size:11px;letter-spacing:.025em;max-width:250px}.tutorial-dialog-header h2{font-size:26px;margin-top:8px}.tutorial-close{min-width:42px;min-height:42px;padding:9px}.tutorial-video-frame{max-height:54dvh}.tutorial-dialog-footer{display:block;padding:20px}.tutorial-dialog-footer>p{font-size:13px;line-height:1.85}.tutorial-dialog-footer>a{font-size:13px;margin-top:19px}.tutorial-video-status{padding:0 20px 20px;font-size:12px}}
</style>

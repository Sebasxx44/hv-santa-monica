---
// Imports
import IconTA from "@/components/IconTA.astro";
import { serviceGalleries } from "@/data/serviceGallery";

// Content
const groups = [
  { id: "24h", label: "Las 24 horas", title: "Cuidado que no mira el reloj.", description: "Conoce los servicios que el hospital presenta para acompañarte a cualquier hora." },
  { id: "7dias", label: "Los 7 días", title: "Cerca en cada etapa.", description: "Explora los servicios de apoyo, cuidado y seguimiento para tu mascota." },
] as const;
const previews = groups.map((group) => ({ ...group, photo: serviceGalleries[group.id][0] }));
---
<div class="service-photo-previews" aria-label="Conoce nuestras áreas de atención">
  {previews.map((preview) => preview.photo && <a class="service-photo-preview reveal" href={`/nuestros-servicios/#grupo-${preview.id}`}>
    <figure class="service-preview-image"><img src={preview.photo.src} srcset={preview.photo.srcset} sizes="(max-width: 760px) 90vw, 45vw" width={preview.photo.width} height={preview.photo.height} alt={preview.photo.alt} loading="lazy" decoding="async" /></figure>
    <div class="service-preview-copy"><span class="service-preview-label">{preview.label}</span><h3>{preview.title}</h3><p>{preview.description}</p><span class="service-preview-link">Ver los servicios <IconTA name="arrow" size={18} /></span></div>
  </a>)}
</div>
<style>
  .service-photo-previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 25px; margin-block: 38px 0; }
  .service-photo-preview { display: flex; flex-direction: column; gap: 24px; padding: 18px; border: 1px solid #d7e8e1; border-radius: 22px; background: #f4faf7; color: #2c3d49; min-width: 0; }
  .service-photo-preview:focus-visible { outline: 2px solid #027b76; outline-offset: 5px; }
  .service-preview-image { width: 100%; aspect-ratio: 3 / 2; margin: 0; border-radius: 14px; overflow: hidden; background: #dcebe4; }
  .service-preview-image img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .service-preview-copy { display: flex; flex-direction: column; min-width: 0; padding: 0 6px 10px; flex: 1; }
  .service-preview-label { display: block; color: #027b76; font-size: 11px; line-height: 1.6; letter-spacing: .08em; text-transform: uppercase; font-weight: 600; }
  .service-preview-copy h3 { font-size: 24px; font-weight: 500; line-height: 1.2; letter-spacing: -.6px; margin: 13px 0 12px; }
  .service-preview-copy p { color: #587378; font-size: 14px; line-height: 1.8; flex: 1; }
  .service-preview-link { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: #027b76; font-size: 13px; font-weight: 500; line-height: 1.6; margin-top: 20px; }
  @media (max-width: 760px) { .service-photo-previews { grid-template-columns: minmax(0, 1fr); gap: 22px; margin-top: 29px; } .service-photo-preview { gap: 21px; padding: 14px; border-radius: 19px; } .service-preview-image { border-radius: 11px; } .service-preview-copy { padding: 0 7px 12px; } .service-preview-copy h3 { font-size: 25px; } .service-preview-copy p { font-size: 14px; line-height: 1.75; } .service-preview-link { margin-top: 20px; } }
</style>

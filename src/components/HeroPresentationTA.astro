---
import IconTA from '@/components/IconTA.astro';
---
<figure class="hero-presentation" data-hero-presentation aria-labelledby="hero-presentation-title">
  <div class="presentation-top"><p id="hero-presentation-title"><span aria-hidden="true"></span>CONOCE SANTA MÓNICA <span class="presentation-separator" aria-hidden="true">·</span> <span>14 s</span></p><IconTA name="paw" size={20}/></div>
  <div class="presentation-frame"><video data-presentation-video width="1280" height="720" poster="/videos/santa-monica-presentacion.webp" preload="none" muted playsinline controls aria-label="Presentación de Santa Mónica" aria-describedby="hero-presentation-description"><source src="/videos/santa-monica-presentacion.mp4" type="video/mp4"/><p>Puedes conocer <a href="/sobre-nosotros/">el hospital y nuestro equipo</a> en la página Sobre nosotros.</p></video></div>
  <figcaption class="presentation-bottom"><p>Cuidarlos. Acompañarte.<br/><strong>Estar cuando nos necesitas.</strong></p><div class="presentation-controls" data-presentation-controls hidden><button type="button" data-presentation-toggle aria-label="Reproducir la presentación de Santa Mónica"><span data-presentation-icon="play"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="m8 5 11 7-11 7Z" fill="currentColor"/></svg></span><span data-presentation-icon="pause" hidden><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4Z" fill="currentColor"/></svg></span><span data-presentation-icon="replay" hidden><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M5 9a8 8 0 1 1-.2 5M5 4v5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span data-presentation-label>Reproducir</span></button></div></figcaption>
  <p id="hero-presentation-description" class="sr-only">Presentación animada del Hospital Veterinario de Santa Mónica. Los servicios, la ubicación y los canales de atención también están disponibles en esta página.</p>
  <p class="presentation-status" data-presentation-status role="status" aria-live="polite"></p>
</figure>
<script>
import { initHeroPresentation } from '@/composables/presentation/initHeroPresentation';
initHeroPresentation();
</script>
<style>
.hero-presentation{position:relative;min-width:0;width:100%;margin:0;padding:15px;background:#e9f5f0;border:1px solid #d1e8df;border-radius:22px;box-shadow:0 18px 55px #027b760a}.presentation-top{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:5px 7px 18px;color:#027b76}.presentation-top>p{display:flex;align-items:center;gap:9px;flex-wrap:wrap;font-size:11px;line-height:1.6;letter-spacing:.06em;font-weight:700}.presentation-top>p>span:first-child{width:6px;height:6px;flex-shrink:0;border-radius:50%;background:#29c4a9}.presentation-top>p>span:last-child{font-variant-numeric:tabular-nums;white-space:nowrap;letter-spacing:0;font-weight:500}.presentation-top>:global(svg){flex-shrink:0;opacity:.65}.presentation-separator{opacity:.6}.presentation-frame{aspect-ratio:16/9;overflow:hidden;border-radius:13px;background:#dceee6}.presentation-frame>video{display:block;width:100%;height:100%;object-fit:contain;background:#e9f5f0}.presentation-frame>video>p{font-size:14px;padding:20px;color:#2c3d49}.presentation-frame a{text-decoration:underline;text-underline-offset:3px}.presentation-bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:21px 8px 7px}.presentation-bottom>p{font-size:12px;line-height:1.8;color:#607d75}.presentation-bottom strong{font-weight:600;color:#2c635a}.presentation-controls{flex-shrink:0}.presentation-controls>button{display:flex;align-items:center;justify-content:center;gap:8px;min-height:42px;min-width:104px;border:1px solid #b2d8ca;border-radius:24px;padding:10px 14px;background:white;color:#027b76;font:inherit;font-size:12px;font-weight:700;line-height:1.4;cursor:pointer;transition:background .2s,border-color .2s}.presentation-controls>button:hover{background:#f7fcfa;border-color:#027b76}.presentation-controls>button:focus-visible{outline:3px solid #027b76;outline-offset:4px}.presentation-controls [data-presentation-icon]{display:flex;flex-shrink:0}.presentation-controls svg{flex-shrink:0}.presentation-status{font-size:11px;line-height:1.7;color:#386d61;margin:13px 8px 4px}.presentation-status:empty{display:none}@media(max-width:1000px){.hero-presentation{padding:12px}.presentation-top{padding:4px 4px 14px}.presentation-top>p{gap:7px;font-size:11px;letter-spacing:.025em}.presentation-top>:global(svg){width:18px}.presentation-bottom{padding:18px 4px 5px;gap:13px}.presentation-bottom>p{font-size:11px}.presentation-controls>button{font-size:11px;gap:7px;min-width:94px;padding-inline:12px}}@media(max-width:760px){.hero-presentation{padding:12px;border-radius:22px;box-shadow:0 10px 30px #027b7608}.presentation-top{padding:3px 4px 13px}.presentation-top>p{font-size:11px;gap:7px;letter-spacing:.025em}.presentation-frame{border-radius:12px}.presentation-bottom{padding:17px 5px 4px;gap:15px}.presentation-bottom>p{font-size:11px}.presentation-controls>button{font-size:11px;min-height:42px;min-width:100px;padding:10px 12px}.presentation-status{margin-inline:5px}}@media(max-width:359px){.presentation-bottom{gap:10px;padding-inline:2px}.presentation-bottom>p{font-size:11px}.presentation-controls>button{min-width:91px;padding-inline:10px;gap:5px}.presentation-top>p{gap:6px;font-size:11px}.presentation-top>:global(svg){display:none}}@media(prefers-reduced-motion:reduce){.presentation-controls>button{transition:none}}
</style>
